{
  "goal": "Build and verify login flow on Android emulator.",
  "kind": "flutter",
  "packageName": "com.example.app",
  "avdName": "Pixel_8_API_35",
  "installDependencies": false,
  "runLint": true,
  "runUnitTests": true,
  "buildDebugApk": true,
  "clearAppData": false,
  "collectEvidence": true,
  "maxTestIterations": 3,
  "appiumCapabilities": {
    "platformName": "Android",
    "appium:automationName": "UiAutomator2",
    "appium:deviceName": "Android Emulator",
    "appium:appPackage": "com.example.app",
    "appium:appActivity": ".MainActivity",
    "appium:noReset": true,
    "appium:forceAppLaunch": true,
    "appium:shouldTerminateApp": true
  },
  "appiumSteps": [
    {
      "tool": "appium.wait_for_visible",
      "args": {
        "locator": {
          "strategy": "text",
          "value": "Login"
        },
        "timeoutMs": 10000
      }
    },
    {
      "tool": "appium.type_text",
      "args": {
        "locator": {
          "strategy": "accessibility id",
          "value": "email"
        },
        "text": "test@example.com"
      }
    },
    {
      "tool": "appium.type_text",
      "args": {
        "locator": {
          "strategy": "accessibility id",
          "value": "password"
        },
        "text": "password123"
      }
    },
    {
      "tool": "appium.tap_by_text",
      "args": {
        "text": "Login"
      }
    }
  ],
  "expectedTexts": ["Home"],
  "approval": {
    "approved": true,
    "approvedBy": "project-owner",
    "reason": "Build, install and test the selected demo using synthetic test data; preserve app data"
  }
}
